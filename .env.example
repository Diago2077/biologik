# ── Cliente (se empaquetan en el bundle, son publicas por diseno) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clave PUBLICA de VAPID (para suscribir el navegador a push). Se genera una
# sola vez con `npx web-push generate-vapid-keys`; la privada NUNCA va aca.
VITE_VAPID_PUBLIC_KEY=

# ── Servidor: SOLO para las funciones de /api ──
# Sin prefijo VITE_, si no quedarian expuestas en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Notificaciones push (api/cron/vacunaciones.ts), corre una vez al dia.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@dominio.com
# Vercel lo manda solo en sus propias invocaciones de cron (Authorization:
# Bearer <esto>); cualquier valor random largo sirve.
CRON_SECRET=
